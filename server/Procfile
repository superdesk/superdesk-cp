wamp: python3 -u ws.py
work: celery -A worker worker -X "${SUPERDESK_CELERY_PREFIX}expiry"
beat: celery -A worker beat -S redbeat.RedBeatScheduler --max-interval 10
capi: hypercorn -c file:hypercorn_config.py content_api.wsgi:application
